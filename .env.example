# Optional Conan remote configuration for the ros2 container.
# Copy to .env or export these variables in the shell; never commit secrets.

CONAN_REMOTE_NAME=rosbridge

# With the current SSH tunnel:
# ssh -N -L 19300:127.0.0.1:9300 ubuntu@<server>
CONAN_REMOTE_URL=http://host.docker.internal:19300

# Use the read-only account for downloads. Keep the password out of Git.
CONAN_LOGIN_USERNAME=ci-reader
CONAN_PASSWORD=
